# ---------------------------------------------------------------------------
# PERMUTADOS — environment template. Copy to .env and fill in. NEVER commit .env.
# All values below are placeholders; none of them is a real credential.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
APP_BASE_URL=https://permutados.example.com
WEBHOOK_BASE_URL=https://permutados.example.com
ADMIN_API_URL=https://permutados.example.com/admin
CORS_ALLOWED_ORIGINS=              # comma separated; never "*" in production

# --- Database / Redis ---
POSTGRES_DB=permutados
POSTGRES_USER=permutados
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://permutados:change-me@postgres:5432/permutados
REDIS_URL=redis://redis:6379/0

# --- Dolphin (OpenAI-compatible server: vLLM / Ollama / llama.cpp) ---
# Leave DOLPHIN_BASE_URL empty until the physical server exists: the bot answers with a safe
# "service temporarily unavailable" message and never changes state.
DOLPHIN_BASE_URL=                  # e.g. http://192.168.1.50:8001/v1
DOLPHIN_MODEL=dphn/Dolphin-Mistral-24B-Venice-Edition
DOLPHIN_API_KEY=
DOLPHIN_TIMEOUT_SECONDS=60
DOLPHIN_MAX_TOOL_ITERATIONS=4
DOLPHIN_ASSETS_PATH=               # folder with prompts/ policies/ tools/ (default: <repo>/dolphin)

# --- WhatsApp Cloud API (1:1 bot) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
# Outside the 24h customer-service window Meta only accepts approved templates. Create and get approved, in
# WhatsApp Manager, a UTILITY template with this name, language es_AR and ONE body variable {{1}}, e.g.:
#   "Tenés una novedad en Permutados: {{1}}. Respondé este mensaje para verla."
WHATSAPP_FALLBACK_TEMPLATE=permutados_novedad
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_SESSION_WINDOW_HOURS=24
WHATSAPP_WINDOW_SAFETY_MINUTES=15   # treat the window as closed this many minutes early
WHATSAPP_MAX_RETRIES=3              # client-level retries (connect errors / throttling only)

# --- WhatsApp Channel (administered MANUALLY — the Cloud API cannot post to Channels) ---
# These only drive the admin "suggested items" list; nothing is published automatically.
CHANNEL_ENABLED=false
CHANNEL_RUN_INTERVAL=3600
CHANNEL_DAILY_LIMIT=10
CHANNEL_MIN_SCORE=40
CHANNEL_MAX_EXPOSURE_PER_ITEM=3
CHANNEL_MIN_HOURS_BETWEEN_SAME_ITEM=48

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=sandbox    # sandbox | production
MERCADOPAGO_SIGNATURE_TOLERANCE_SECONDS=600
MERCADOPAGO_BACK_URL=              # optional https page shown after paying (enables auto_return)
MERCADOPAGO_STATEMENT_DESCRIPTOR=PERMUTADOS
MERCADOPAGO_COLLECTOR_ID=          # optional: your MP user id; payments to another collector are rejected
MERCADOPAGO_MAX_RETRIES=3

# --- Business rules (defaults; editable at runtime from the admin API -> system_config) ---
CONTACT_RELEASE_PRICE=3000
CONTACT_RELEASE_CURRENCY=ARS       # only ARS is accepted
OFFER_EXPIRATION_HOURS=24          # owner has 24h to accept/reject; both parties are told at creation
PAYMENT_WINDOW_HOURS=24            # bidder has 24h to pay after acceptance
PUBLICATION_EXPIRATION_DAYS=30
PUBLICATION_EXPIRY_WARNING_DAYS=3
MAX_ACTIVE_OFFERS_PER_BIDDER=3

# --- Images ---
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_BYTES=2048
MIN_IMAGE_SIDE_PX=320
MAX_IMAGE_SIDE_PX=8000
MAX_IMAGES_PER_ITEM=1
STORAGE_PATH=/data/storage

# --- Admin auth / security ---
ADMIN_AUTH_SECRET=                 # >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_ACCESS_TOKEN_MINUTES=15
ADMIN_REFRESH_TOKEN_DAYS=7
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_USER_MESSAGES_PER_MINUTE=30
# Field-level encryption of phone numbers / names / sensitive messages (AES-256-GCM). REQUIRED.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# Losing this key = losing every phone number. Back it up OUTSIDE the database backups.
ENCRYPTION_KEY=
ENCRYPTION_OLD_KEYS=               # comma separated, only during a rotation (scripts/rotate_encryption_key.py)

# --- Workers (inbound queue + outbox) ---
INBOUND_POLL_SECONDS=2
INBOUND_BATCH_SIZE=20
INBOUND_MAX_ATTEMPTS=5
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_SENDING_GRACE_SECONDS=900   # in-flight (SENDING) rows older than this are recovered after a crash

# --- Backups (scripts/backup_postgres.sh / .py, restore_postgres.py) ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=7                  # newest N backups are always kept, whatever their age
BACKUP_MODE=                       # docker | native (empty: docker if available)
BACKUP_DOCKER_SERVICE=postgres
BACKUP_COPY_CMD=                   # optional off-site copy, {file} = backup path, e.g. rclone copy {file} remote:permutados
RESTORE_DATABASE_URL=              # target for restore_postgres.py (defaults to DATABASE_URL)
