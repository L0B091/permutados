  {
    "type": "function",
    "function": {
      "name": "create_offer",
      "description": "Hacer una oferta (MONEY, SWAP o COMBINED) por el artículo elegido. Vence en 24h.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "anyOf": [
              {
                "pattern": "^ITEM-[23456789ABCDEFGHJKMNPQRSTVWXYZ]{5,8}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Item Id"
          },
          "offer_type": {
            "enum": [
              "MONEY",
              "SWAP",
              "COMBINED"
            ],
            "title": "Offer Type",
            "type": "string"
          },
          "offered_price": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Offered Price"
          },
          "offered_item": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Offered Item"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Message"
          }
        },
        "required": [
          "offer_type"
        ],
        "type": "object"
      }
    }
  },
