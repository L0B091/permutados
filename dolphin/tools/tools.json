  {
    "type": "function",
    "function": {
      "name": "select_publication",
      "description": "Elegir un artículo por número, código o descripción.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "reference": {
            "description": "Number 1-5, ordinal, ITEM code or description",
            "maxLength": 120,
            "title": "Reference",
            "type": "string"
          }
        },
        "required": [
          "reference"
        ],
