[
  {
    "type": "function",
    "function": {
      "name": "create_publication",
      "description": "Crear un BORRADOR con la foto que el usuario acaba de enviar y tu sugerencia de identificación (nunca precio).",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "category": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Category"
          },
          "brand": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Brand"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          }
        },
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_my_publications",
      "description": "Listar las publicaciones activas del usuario.",
      "parameters": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_publication",
      "description": "Ver una publicación por código. Si es un borrador completo del usuario devuelve la previsualización.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "pattern": "^ITEM-[23456789ABCDEFGHJKMNPQRSTVWXYZ]{5,8}$",
            "title": "Item Id",
            "type": "string"
          }
        },
        "required": [
          "item_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_publication",
      "description": "Completar un borrador (datos básicos, publish=true tras confirmar la previsualización) o editar una publicación propia.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "pattern": "^ITEM-[23456789ABCDEFGHJKMNPQRSTVWXYZ]{5,8}$",
            "title": "Item Id",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "category": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Category"
          },
          "identification_confirmed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Identification Confirmed"
          },
          "zone": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Zone"
          },
          "price": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact price stated by the user",
            "title": "Price"
          },
          "accepts_swap": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Accepts Swap"
          },
          "has_damage": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Has Damage"
          },
          "damage_description": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Damage Description"
          },
          "works": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Works"
          },
          "malfunction_description": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Malfunction Description"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "publish": {
            "default": false,
            "description": "Publish a DRAFT. Only after the user confirmed the preview.",
            "title": "Publish",
            "type": "boolean"
          }
        },
        "required": [
          "item_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "delete_publication",
      "description": "Borrar una publicación propia (por código o como la nombró el usuario).",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "reference": {
            "description": "ITEM code or how the user named it",
            "maxLength": 120,
            "title": "Reference",
            "type": "string"
          }
        },
        "required": [
          "reference"
        ],
        "type": "object"
      }
    }
  },
